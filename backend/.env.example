NODE_ENV=development
PORT=4000
HOST=0.0.0.0
TRUST_PROXY=false
DATABASE_URL=postgresql://spectramind:spectramind@localhost:5432/spectramind?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
CORS_ORIGINS=http://localhost:5173
FRAMEWORK_LIBRARY_PATH=../spectramind/src/core/framework-library
LOCAL_FILE_ROOT=./data/files

# Azure App Service example values (configure these as App Settings; do not commit secrets):
# NODE_ENV=production
# TRUST_PROXY=true
# CORS_ORIGINS=https://YOUR-STATIC-WEB-APP-HOSTNAME.azurestaticapps.net
# DATABASE_URL=postgresql://DB_ADMIN:URL_ENCODED_PASSWORD@POSTGRES_SERVER.postgres.database.azure.com:5432/spectramind?schema=public&sslmode=verify-full
# FRAMEWORK_LIBRARY_PATH=/home/site/wwwroot/framework-library
# LOCAL_FILE_ROOT=/home/data/files
